{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "咸蛋黄风味偏差追因簿领域事件",
  "type": "object",
  "required": [
    "event_id",
    "event_type",
    "aggregate_type",
    "aggregate_id",
    "occurred_at",
    "version",
    "payload"
  ],
  "properties": {
    "event_id": {
      "type": "string",
      "minLength": 1
    },
    "event_type": {
      "type": "string",
      "enum": [
        "LOT_ACCEPTED",
        "THRESHOLD_PUBLISHED",
        "BATCH_TRANSFORMED",
        "OBSERVATION_RECORDED",
        "BATCH_RELEASED",
        "DEVIATION_EXEMPTION_GRANTED",
        "SHIPMENT_DISPATCHED",
        "COMPLAINT_FILED",
        "STOCK_HELD",
        "DISPOSITION_APPROVED"
      ]
    },
    "aggregate_type": {
      "type": "string",
      "enum": [
        "raw_yolk_lot",
        "threshold",
        "process_batch",
        "quality_observation",
        "shipment",
        "complaint",
        "disposition_case"
      ]
    },
    "aggregate_id": {
      "type": "string",
      "minLength": 1
    },
    "occurred_at": {
      "type": "string",
      "format": "date-time"
    },
    "version": {
      "type": "integer",
      "minimum": 1
    },
    "payload": {
      "type": "object"
    }
  },
  "payload_required_by_event": {
    "LOT_ACCEPTED": [
      "supplier",
      "grade",
      "quantity"
    ],
    "THRESHOLD_PUBLISHED": [
      "metric",
      "limits",
      "effective_from"
    ],
    "BATCH_TRANSFORMED": [
      "stage",
      "step_id",
      "unit",
      "input_allocations",
      "outputs"
    ],
    "OBSERVATION_RECORDED": [
      "target",
      "method_version",
      "metric",
      "result"
    ],
    "BATCH_RELEASED": [
      "batch_id",
      "threshold_versions",
      "decided_by"
    ],
    "DEVIATION_EXEMPTION_GRANTED": [
      "batch_id",
      "step_id",
      "metric",
      "responsible",
      "granted_by",
      "reason"
    ],
    "SHIPMENT_DISPATCHED": [
      "store_id",
      "allocations",
      "sell_by"
    ],
    "COMPLAINT_FILED": [
      "store_id",
      "purchased_at",
      "symptoms"
    ],
    "STOCK_HELD": [
      "scope",
      "reason",
      "held_by"
    ],
    "DISPOSITION_APPROVED": [
      "scope",
      "decision",
      "approved_by"
    ]
  },
  "additionalProperties": false
}
